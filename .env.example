# Local application
DATABASE_URL="postgresql://admin:password@localhost:7432/keydrop?schema=public"
PORT=4000
NODE_ENV=development
SWAGGER_ENABLED=true

# Cognito customer authentication
USER_COGNITO_USER_POOL_ID=
USER_COGNITO_CLIENT_ID=
RECIPIENT_ACCESS_TOKEN_SECRET=
# The app client must allow USER_PASSWORD_AUTH and REFRESH_TOKEN_AUTH.

# Cognito staff authentication
ADMIN_COGNITO_USER_POOL_ID=
ADMIN_COGNITO_CLIENT_ID=

COGNITO_REGION=ap-south-1

# Private file storage
S3_REGION=ap-south-1
S3_BUCKET=
ASSETS_CUSTOM_DOMAIN=false
ASSETS_DOMAIN_NAME=
ASSETS_URL=

# Team invitation email delivery (AWS SES)
SES_REGION=ap-south-1
SES_FROM_EMAIL=
FRONTEND_URL=http://localhost:3000

# Razorpay billing
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PRO_MONTHLY_PLAN_ID=
RAZORPAY_PRO_YEARLY_PLAN_ID=
RAZORPAY_TEAM_MONTHLY_PLAN_ID=
RAZORPAY_TEAM_YEARLY_PLAN_ID=
