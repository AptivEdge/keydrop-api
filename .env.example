# Local application
# Runtime connection: use Supabase's transaction pooler URL for Vercel
# (port 6543 with pgbouncer=true); retain the local URL for local development.
# URL shape: postgresql://postgres.<project-ref>:<db-password>@<pooler-host>:6543/postgres?pgbouncer=true
DATABASE_URL=postgresql://admin:password@127.0.0.1:5433/keydrop?schema=public
# Prisma CLI migrations: use a Supabase direct or session-pooler URL (port
# 5432). When unset locally, Prisma CLI falls back to DATABASE_URL.
# This project's direct URL host is db.gihoxmacletkytkzibsy.supabase.co; use
# the exact connection string shown by Dashboard > Connect.
DIRECT_URL=
PORT=4000
NODE_ENV=development
APP_ENV=local
SWAGGER_ENABLED=true

# Supabase Auth (recommended target provider)
AUTH_PROVIDER=supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-only. Required for API-managed identity creation and administration.
SUPABASE_SERVICE_ROLE_KEY=
# Temporary, high-entropy secret for POST /api/v1/admin/bootstrap.
# Configure only until the first ADM is created, then remove it.
ADMIN_BOOTSTRAP_TOKEN=

# Cloudflare R2 (recommended target provider; private objects use signed URLs)
STORAGE_PROVIDER=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=
# Keep R2 objects private; use short-lived signed URLs rather than a public URL.
R2_PUBLIC_URL=

# Resend (all application and Supabase Auth emails are sent by the API)
EMAIL_PROVIDER=resend
EMAIL_API_KEY=
EMAIL_FROM=
# Published Resend template aliases or IDs. See docs/email-templates.md.
EMAIL_TEMPLATE_AUTH_VERIFICATION=
EMAIL_TEMPLATE_PASSWORD_RESET=
EMAIL_TEMPLATE_RECIPIENT_ACCESS=
EMAIL_TEMPLATE_TEAM_INVITATION=
EMAIL_TEMPLATE_SECRET_REQUEST=
EMAIL_TEMPLATE_NOTIFICATION_SECRET_CREATED=
EMAIL_TEMPLATE_NOTIFICATION_SECRET_VIEWED=
EMAIL_TEMPLATE_NOTIFICATION_SECRET_EXPIRING=
EMAIL_TEMPLATE_NOTIFICATION_SECRET_EXPIRED=
EMAIL_TEMPLATE_NOTIFICATION_ACCESS_REQUESTED=
EMAIL_TEMPLATE_NOTIFICATION_ACCESS_GRANTED=
EMAIL_TEMPLATE_NOTIFICATION_ACCESS_DENIED=
EMAIL_TEMPLATE_NOTIFICATION_BILLING_PAYMENT_FAILED=
FRONTEND_URL=http://localhost:3000
RECIPIENT_ACCESS_TOKEN_SECRET=
SECRET_AUTH_PEPPER=

# Razorpay billing
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PRO_MONTHLY_PLAN_ID=
RAZORPAY_PRO_YEARLY_PLAN_ID=
RAZORPAY_TEAM_MONTHLY_PLAN_ID=
RAZORPAY_TEAM_YEARLY_PLAN_ID=

# Supabase Cron -> protected Vercel internal-job endpoints (server-side only)
INTERNAL_JOBS_TOKEN=
