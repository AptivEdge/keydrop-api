model AdminUser {
  id         String    @id @default(cuid())
  userId     String    @unique
  role       AdminRole
  ssoSubject String    @unique
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([role])
}
