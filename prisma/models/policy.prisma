model Policy {
  id         String     @id @default(cuid())
  ownerId    String?
  teamId     String?
  policyType PolicyType
  rules      Json
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  owner User? @relation("UserPolicies", fields: [ownerId], references: [id], onDelete: Cascade)
  team  Team? @relation("TeamPolicies", fields: [teamId], references: [id], onDelete: Cascade)

  @@index([ownerId, policyType])
  @@index([teamId, policyType])
}
